.env
.venv/
__pycache__/
*.pyc
node_modules/
.DS_Store
# Next.js build output, wherever it lands. apps/web/.gitignore has `/.next/`,
# but a leading slash anchors the pattern to that file's own directory, so a
# build run from the repo root wrote .next/trace and .next/trace-build here and
# nothing objected: both were committed, one of them recording a failed build
# from a Next version this tree does not pin. Unanchored, so it holds at any
# depth. These regenerate on every build and the class normally carries
# absolute filesystem paths, which is the second reason they never belong here.
.next/
# personal voice recordings never enter the public repo (DECISIONS #005)
evals/suites/bakeoff/clips/
evals/suites/bakeoff/manual/*.yaml
!evals/suites/bakeoff/manual/sheet-template.yaml
.superpowers/
# controlled delivery-eval clips are voice recordings (DECISIONS #005)
evals/suites/delivery_discrimination/clips/*.wav
# Morgan naturalness recordings are voice recordings (DECISIONS #005) —
# session copies and AVM references both; only the READMEs are committed
evals/suites/morgan_naturalness/clips/*
!evals/suites/morgan_naturalness/clips/README.md
evals/suites/morgan_naturalness/reference/*
!evals/suites/morgan_naturalness/reference/README.md
# generated eval outputs (the numbers of record are committed verbatim as an
# evals/reports/ snapshot per release, cited by docs/releases + CHANGELOG)
evals/out/
.gstack/
